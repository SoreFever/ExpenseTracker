@page "/expenses"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Expenses</PageTitle>
<h3>Expenses</h3>

@if (errors.Count > 0)
{
  <ul class="text-danger">
    @foreach (var error in errors)
    {
      <li>@error</li>
    }
  </ul>
}

<div class="mb-3 d-flex gap-2">
  <input type="number" step="0.01" @bind="amount" placeholder="Amount" />
  <input type="date" @bind="date" />
  <input @bind="description" placeholder="Description" />
  <select @bind="categoryId">
    <option value="0">Choose category</option>
    @foreach (var c in categories)
    {
      <option value="@c.Id">@c.Name</option>
    }
  </select>
  <button class="btn btn-primary" @onclick="Add">Add</button>
</div>

@if (loading)
{
  <p>Loading...</p>
}
else if (expenses.Count == 0)
{
  <p>No expenses yet.</p>
}
else
{
  <table class="table">
    <thead>
      <tr><th>Date</th><th>Description</th><th>Category</th><th>Amount</th><th></th></tr>
    </thead>
    <tbody>
      @foreach (var e in expenses)
      {
        <tr>
          <td>@e.Date</td>
          <td>@e.Description</td>
          <td>@e.Category</td>
          <td>@e.Amount.ToString("N2")</td>
          <td><button class="btn btn-sm btn-danger" @onclick="() => Delete(e.Id)">Delete</button></td>
        </tr>
      }
    </tbody>
  </table>
}


@code {
  private List<ExpenseDto> expenses = new();
  private List<CategoryDto> categories = new();
  private List<string> errors = new();
  private bool loading = true;

  private decimal amount;
  private DateOnly date = DateOnly.FromDateTime(DateTime.Today);
  private string description = "";
  private int categoryId;

  protected override async Task OnInitializedAsync()
  {
    categories = await Http.GetFromJsonAsync<List<CategoryDto>>("categories") ?? new();
    await Load();
    loading = false;
  }

  private async Task Load() => 
    expenses = await Http.GetFromJsonAsync<List<ExpenseDto>>("expenses") ?? new();

  private async Task Add()
  {
    errors.Clear();
    var response = await Http.PostAsJsonAsync("expenses", new {amount, date, description, categoryId});

    if (response.IsSuccessStatusCode)
    {
      amount = 0;
      description = "";
      await Load();
    }
    else
    {
      var problem = await response.Content.ReadFromJsonAsync<ValidationProblem>();
      errors = problem?.Errors.SelectMany(kv => kv.Value).ToList() ?? new() { "Something went wrong."};
    }
  }

  private async Task Delete(int id)
  {
    await Http.DeleteAsync($"expenses/{id}");
    await Load();
  }
}